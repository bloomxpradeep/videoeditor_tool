{
  "name": "reel-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Browser chat UI for editors to direct Claude + the Premiere MCP",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,ui \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && tsx server/index.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p ui"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.312",
    "dompurify": "^3.4.17",
    "express": "^5.3.0",
    "marked": "^18.1.2",
    "multer": "^2.5.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
